# Puertos del host
PORT_WEB=91
PORT_DB=3307
PORT_PMA=8082
PORT_CADVISOR=8080

# Base de datos
DB_NAME=landj_db
DB_USER=root
DB_PASSWORD=cambiar_por_contraseña_segura

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@ejemplo.com
SMTP_PASS=tu_contraseña_de_aplicacion
MAIL_FROM=tu_email@ejemplo.com

# Semilla inicial (opcional)
INITIAL_ADMIN_PASSWORD=Admin_LandJ#2026!
INITIAL_USER_PASSWORD=User_LandJ#2026!

# Recordatorios de cobro (servicio "cron"): cada cuántos segundos revisa facturas vencidas
CRON_INTERVALO_SEGUNDOS=3600

# Mantenimiento: true bloquea temporalmente la web con una página 503.
# Tras cambiarlo, reinicia solo Nginx: docker compose up -d --force-recreate web
MAINTENANCE_MODE=false
